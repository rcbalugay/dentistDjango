# Django Core Settings
DEBUG=True
SECRET_KEY=replace-with-a-secure-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1,web
TIME_ZONE=Asia/Manila

# Database Configuration (PostgreSQL in Docker Compose)
DATABASE_URL=postgres://postgres:devpassword@db:5432/dentist_db

# Cryptography (Fernet 32-byte url-safe base64 key)
FIELD_ENCRYPTION_KEY=replace-with-a-fernet-key

# External APIs
WEATHERAPI_KEY=
GOOGLE_MAPS_API_KEY=

# Email Settings
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
CONTACT_EMAIL=info@dentistclinic.local
DEFAULT_FROM_EMAIL=info@dentistclinic.local
